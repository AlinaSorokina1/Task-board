{
  "name": "taskboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "json-server --watch db.json --port 3001",
    "seed": "node scripts/seed-tasks.js",
    "obs:grafana-up": "docker compose -f observability-local/grafana-loki/docker-compose.yml up -d",
    "obs:grafana-down": "docker compose -f observability-local/grafana-loki/docker-compose.yml down",
    "obs:grafana-logs": "docker compose -f observability-local/grafana-loki/docker-compose.yml logs -f",
    "obs:grafana-reset": "docker compose -f observability-local/grafana-loki/docker-compose.yml down -v --remove-orphans"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@grafana/faro-web-sdk": "^2.3.1",
    "@mantine/charts": "^8.3.15",
    "@mantine/core": "^8.3.15",
    "@mantine/hooks": "^8.3.15",
    "@mantine/modals": "^8.3.15",
    "@mantine/notifications": "^8.3.15",
    "@reduxjs/toolkit": "^2.11.2",
    "@sentry/react": "^10.48.0",
    "@tanstack/react-virtual": "^3.13.19",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0",
    "react-window": "^2.2.7",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "json-server": "^1.0.0-beta.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
