logging {
  level = "info"
}

faro.receiver "frontend" {
  server {
    listen_address      = "0.0.0.0"
    listen_port         = 12347
    cors_allowed_origins = ["*"]
  }

  output {
    logs = [loki.write.local.receiver]
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }

  external_labels = {
    source = "faro",
  }
}
